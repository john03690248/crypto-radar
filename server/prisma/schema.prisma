datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  username     String?
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  watchlist    WatchlistItem[]

  @@map("users")
}

model WatchlistItem {
  id              String   @id @default(uuid())
  userId          String
  symbol          String   // e.g. BTCUSDT, ETHUSDT
  coinName        String?  // e.g. Bitcoin
  notes           String?  // 個人筆記
  targetAlertHigh Float?   // 高於此價位提醒
  targetAlertLow  Float?   // 低於此價位提醒
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@map("watchlist_items")
}

model NewsItem {
  id          String   @id @default(uuid())
  externalId  String   @unique
  title       String
  source      String
  url         String
  summary     String?
  imageUrl    String?
  categories  String?  // 標籤如 "BTC|MARKET"
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@map("news_items")
}
